{% extends 'base.html.twig' %}

{% block title %}Painel | Controle de Estoque{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Painel</h1>
            <p class="text-muted mb-0">Visão geral do estoque.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" href="{{ path('app_categoria_index') }}">Gerenciar categorias</a>
            <a class="btn btn-primary" href="{{ path('app_produto_index') }}">Gerenciar produtos</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <p class="text-muted text-uppercase small mb-1">Categorias</p>
                    <p class="display-6 mb-0">{{ totalCategorias }}</p>
                </div>
                <div class="card-footer bg-white border-0">
                    <a href="{{ path('app_categoria_index') }}">Ver categorias</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <p class="text-muted text-uppercase small mb-1">Produtos</p>
                    <p class="display-6 mb-0">{{ totalProdutos }}</p>
                </div>
                <div class="card-footer bg-white border-0">
                    <a href="{{ path('app_produto_index') }}">Ver produtos</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <p class="text-muted text-uppercase small mb-1">Unidades em estoque</p>
                    <p class="display-6 mb-0">{{ totalUnidades }}</p>
                </div>
                <div class="card-footer bg-white border-0">
                    <a href="{{ path('app_produto_index') }}">Movimentar estoque</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
