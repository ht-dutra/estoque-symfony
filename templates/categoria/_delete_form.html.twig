<form method="post" action="{{ path('app_categoria_delete', {'id': categoria.id}) }}" onsubmit="return confirm('Excluir a categoria {{ categoria.nome|e('js') }}?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categoria.id) }}">
    <button class="btn btn-outline-danger" type="submit">Excluir</button>
</form>
