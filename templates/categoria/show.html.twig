{% extends 'base.html.twig' %}

{% block title %}Categoria | Controle de Estoque{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h3 mb-0">Categoria</h1>
                <a class="btn btn-outline-secondary" href="{{ path('app_categoria_index') }}">Voltar</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">{{ categoria.id }}</dd>
                        <dt class="col-sm-3">Nome</dt>
                        <dd class="col-sm-9">{{ categoria.nome }}</dd>
                    </dl>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                    <a class="btn btn-primary" href="{{ path('app_categoria_edit', {'id': categoria.id}) }}">Editar</a>
                    {{ include('categoria/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
