{% extends 'base.html.twig' %}

{% block title %}Categorias | Controle de Estoque{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Categorias</h1>
            <p class="text-muted mb-0">Organize os produtos por categoria.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('app_categoria_new') }}">Nova categoria</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                {% for categoria in categorias %}
                    <tr>
                        <td>{{ categoria.id }}</td>
                        <td>{{ categoria.nome }}</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_categoria_show', {'id': categoria.id}) }}">Visualizar</a>
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('app_categoria_edit', {'id': categoria.id}) }}">Editar</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">Nenhuma categoria cadastrada.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
