{{ form_start(form, {'action': action}) }}
    <div class="row g-3">
        <div class="col-md-8">
            {{ form_row(form.nome) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.categoria) }}
        </div>
        <div class="col-12">
            {{ form_row(form.descricao) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.valor) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.quantidade) }}
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary">{{ button_label|default('Salvar') }}</button>
        <a class="btn btn-outline-secondary" href="{{ path('app_produto_index') }}">Cancelar</a>
    </div>
{{ form_end(form) }}
