{% extends 'base.html.twig' %}

{% block title %}Novo produto | Controle de Estoque{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h3 mb-0">Novo produto</h1>
                <a class="btn btn-outline-secondary" href="{{ path('app_produto_index') }}">Voltar</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    {{ include('produto/_form.html.twig', {
                        'button_label': 'Cadastrar',
                        'action': path('app_produto_create')
                    }) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
