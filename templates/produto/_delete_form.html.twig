<form method="post" action="{{ path('app_produto_delete', {'id': produto.id}) }}" onsubmit="return confirm('Excluir o produto {{ produto.nome|e('js') }}?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produto.id) }}">
    <button class="btn btn-outline-danger" type="submit">Excluir produto</button>
</form>
